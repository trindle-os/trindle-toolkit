# machine translated (Simplified Chinese), not yet reviewed by a native speaker.

kit-sheet-out-of-range = 第 { $line } 行：--{ $name } 是 { $value }，必须介于 { $min } 和 { $max } 之间。

kit-sheet-short = 在{ $look }外观下，{ $on }上的 --{ $ink } 对比度为 { $stands } 比 1，至少需要 { $floor } 比 1。

kit-sheet-dark = 深色

kit-sheet-light = 浅色

kit-sheet-fine = { $file }：没有发现问题。

kit-sheet-unread = 无法读取 { $file }。

kit-sheet-usage =
    用法：trindle-sheet-check [file.css ...]
    根据 Trindle 的限制和 WCAG 2.2 AA 检查每个样式表（默认检查你自己的样式表和主题）。

kit-inspect-size = { $w } x { $h } 像素，位于 { $x }, { $y }

kit-inspect-state = 状态：{ $state }

kit-inspect-keyboard = 有键盘焦点

kit-inspect-pointer = 指针在其上方

kit-inspect-pressed = 已按下

kit-inspect-takes-keys = 可以输入文字

kit-inspect-off = 无法使用

kit-inspect-rest = 正常

kit-inspect-reader = 屏幕阅读器：{ $role }“{ $name }”

kit-inspect-unread = 屏幕阅读器：没有描述

kit-speed-paint = 绘制耗时：{ $ms } 毫秒

kit-speed-memory = 内存 { $mb } MB

kit-speed-damage = 重绘：占窗口的 { $share }%

kit-speed-gpu = 由显卡绘制

kit-speed-processor = 由处理器绘制

kit-new-usage =
    用法：trindle-new <name> [--toolkit <path>]
    创建名为 <name> 的文件夹，内含一个带一个窗口的程序、一个样式表、一个语言文件和一个测试。使用 --toolkit 时，会使用该路径下的工具包。

kit-new-bad-name = { $name } 不能作为程序名称。请使用小写字母、数字和连字符，并以字母开头。

kit-new-exists = { $name } 已经存在，所以没有写入任何内容。

kit-new-no-toolkit = 在 { $path } 没有找到工具包。

kit-new-unwritten = 无法写入 { $path }。

kit-new-made = 已创建 { $name }。用 cargo run 运行，用 cargo test 测试。

