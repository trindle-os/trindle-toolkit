# Why a file was not read or written, worded as a clause that can follow "because".
kit-files-not-text = the file it's saved in isn't text, so it can't be read
kit-files-not-allowed = your account isn't allowed to read the file it's saved in
kit-files-not-ordinary = the file it's saved in isn't an ordinary file, so it can't be read
kit-files-unreadable = the file it's saved in can't be read
kit-files-too-big = the file it's saved in is too big to read in one go
kit-files-no-name-kept = it has no file name to save it under
kit-files-dangling = it's a link to something that doesn't exist
kit-files-nought = its name contains a zero byte, which isn't allowed
kit-files-taken = there is already something with that name
kit-files-not-a-name = it isn't a valid name for an item in a folder
kit-files-old-name-stays = the old name couldn't be removed
kit-files-no-name-opened = it has no file name to open it with
kit-files-not-plain = it must be a single file name
kit-files-name-unkeepable = its name can't be saved in a settings file
kit-files-char-unkeepable = it has a line break or another character that can't be saved
kit-files-changed = it changed while it was being copied
kit-files-not-a-file = it isn't a file or a folder

# What a program with no window says when it cannot reach the desktop.
kit-windowless-no-desktop = Trindle couldn't reach the desktop
kit-windowless-no-answer = the desktop didn't respond
kit-windowless-no-seat = the desktop has no keyboard or mouse

# Answers to a call over the session bus that could not be made.
kit-bus-no-answer-in-time = The request timed out.
kit-bus-already-offered = This interface is already available at this path.
kit-bus-bad-path = This object path isn't valid.
kit-bus-too-many-waiting = Too many requests are waiting. Try again.
kit-bus-no-machine-id = The machine ID is missing.
kit-bus-busy = Another request to this interface is in progress. Try again.
kit-bus-no-interface = This interface wasn't found.
kit-bus-no-object = This object wasn't found.
kit-bus-give-interface = Specify an interface.
kit-bus-give-property = Specify an interface and a property.
kit-bus-give-value = Specify an interface, a property and a value.
kit-bus-no-property = This property wasn't found.
kit-bus-read-only = This property can't be changed.
kit-bus-unanswered = The request received no response.
kit-bus-closed = the connection closed
kit-bus-no-method-here = This method wasn't found.

# Answers from the media player link and the notification link.
kit-mpris-seek = Seek requires a time.
kit-mpris-set-position = SetPosition requires a track and a time.
kit-mpris-no-uri = This player can't open addresses.
kit-mpris-app-id = The app ID must be a simple reverse-domain name.
kit-notify-bad-arguments = The arguments aren't valid for this call.
kit-once-raise-only = only Raise is supported here

# Why a document could not be made into a PDF.
kit-print-too-long = the document is longer than 200 pages
kit-print-no-room = there isn't enough memory to draw the pages
