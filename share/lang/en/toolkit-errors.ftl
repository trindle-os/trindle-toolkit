# Why a file was not read or written, worded as a clause that can follow "because".
kit-files-not-text = the file that keeps it is not text and cannot be read
kit-files-not-allowed = this account is not allowed to read the file that keeps it
kit-files-not-ordinary = the file that keeps it is not an ordinary file and cannot be read
kit-files-unreadable = the file that keeps it cannot be read
kit-files-too-big = the file that keeps it is too big to be read whole
kit-files-no-name-kept = it has no name to be kept under
kit-files-dangling = it is a link to a place that is not there
kit-files-nought = a name cannot hold a nought
kit-files-taken = there is already something with that name
kit-files-not-a-name = not a name in a folder
kit-files-old-name-stays = the old name could not be taken away
kit-files-no-name-opened = it has no name to be opened inside the folder
kit-files-not-plain = not one plain name
kit-files-name-unkeepable = its name cannot be kept in a settings file
kit-files-char-unkeepable = it has a line break or another character that cannot be kept
kit-files-changed = it changed while it was being copied
kit-files-not-a-file = not a file or a folder

# What a program with no window says when it cannot reach the desktop.
kit-windowless-no-desktop = no desktop to talk to
kit-windowless-no-answer = the desktop did not answer
kit-windowless-no-seat = the desktop has no keyboard or mouse

# Answers to a call over the session bus that could not be made.
kit-bus-no-answer-in-time = No answer came in time.
kit-bus-already-offered = That interface is already offered at this path.
kit-bus-bad-path = That is not a valid object path.
kit-bus-too-many-waiting = Too many calls waiting; try again.
kit-bus-no-machine-id = No machine id.
kit-bus-busy = Busy with another call to this interface; try again.
kit-bus-no-interface = No such interface here.
kit-bus-no-object = No such object here.
kit-bus-give-interface = Give an interface.
kit-bus-give-property = Give an interface and a property.
kit-bus-give-value = Give an interface, a property and a value.
kit-bus-no-property = No such property.
kit-bus-read-only = This property cannot be set.
kit-bus-unanswered = No answer was given.
kit-bus-closed = the bus closed
kit-bus-no-method-here = No such method here.

# Answers from the media player link and the notification link.
kit-mpris-seek = Seek takes a time.
kit-mpris-set-position = SetPosition takes a track and a time.
kit-mpris-no-uri = This player opens no addresses.
kit-mpris-app-id = The app id is not a plain reverse-domain name.
kit-notify-bad-arguments = The arguments do not fit this call.
kit-once-raise-only = only Raise is offered here

# Why a document could not be made into a PDF.
kit-print-too-long = the document is longer than 200 pages
kit-print-no-room = no room to paint the pages
